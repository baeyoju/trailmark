{
  "manifest_version": 2,
  "name": "Local Browser Tracker",
  "version": "1.0.0",
  "description": "Keeps a private, local record of pages you visit.",
  "permissions": ["webNavigation", "tabs", "http://127.0.0.1:5000/*"],
  "background": { "scripts": ["background.js"] },
  "browser_specific_settings": {
    "gecko": { "id": "local-browser-tracker@example.invalid" }
  }
}
